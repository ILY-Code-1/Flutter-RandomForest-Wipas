@startuml wb_02_dp_flowgraph
skinparam defaultFontName Arial
skinparam shadowing false
top to bottom direction
circle "1" as n1
circle "2" as n2
circle "3" as n3
circle "4" as n4
circle "5" as n5
circle "6" as n6
n1 --> n4
n1 --> n2
n2 --> n4
n2 --> n3
n3 --> n4
n3 --> n5
n4 --> n6
n5 --> n6
legend right
  1: predicted == null?
  2: projection == null?
  3: projection <= 0?
  4: return null
  5: return deviasi
  6: exit
endlegend
@enduml