{
  "name": "wipas-firestore-rules-tests",
  "private": true,
  "description": "Security rules tests for WIPAS (Firestore Emulator, project demo-wipas).",
  "type": "module",
  "scripts": {
    "test": "node --test --test-concurrency=1 rules.test.mjs",
    "test:emulator": "firebase emulators:exec --only firestore --project demo-wipas --config ../../firebase.json \"npm test\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "firebase": "^13.0.0",
    "firebase-tools": "^15.0.0"
  }
}
